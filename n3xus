#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$ROOT/scripts/device_cli.py" "$@"
elif command -v python >/dev/null 2>&1; then
  exec python "$ROOT/scripts/device_cli.py" "$@"
fi
echo 'Install Python 3.10+ on host first. No WSL/Ansible is needed.' >&2
exit 1
