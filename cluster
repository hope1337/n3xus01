#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ ${1:-help} == help || ${1:-} == --help || ${1:-} == -h ]]; then
  cat <<'HELP'
Personal compute: setup -> add-device -> check -> ask your agent
  ./cluster setup
  ./cluster add-device [NAME] [--address TAILSCALE_IP] [--user SSH_USER] [--gpu]
  ./cluster check                 live CPU/network/GPU checks
  ./cluster check --static        local tests, no SSH
  ./cluster status
  ./cluster kubectl get pods -A   advanced troubleshooting
  ./cluster run DEVICE --image IMAGE [--gpu] -- COMMAND ARGUMENTS...
  ./cluster jobs | logs JOB | wait JOB | delete-job JOB
  ./cluster reset DEVICE --yes-delete-cluster
Windows: use .\cluster.ps1 with the same arguments.
HELP
  exit 0
fi
[[ "$(uname -s)" == Linux ]] || { echo 'Use cluster.ps1 on Windows.' >&2; exit 1; }
if [[ -n ${CLUSTER_WINDOWS_SSH:-} ]]; then
  ID="$(printf '%s' "$ROOT" | sha256sum | cut -c1-16)"
  export CLUSTER_STATE_DIR="${CLUSTER_STATE_DIR:-$HOME/.local/share/personal-compute/$ID}"
  export ANSIBLE_SSH_EXECUTABLE="$CLUSTER_WINDOWS_SSH"
  export ANSIBLE_SSH_ARGS='-o ControlMaster=no -o StrictHostKeyChecking=yes -o BatchMode=yes'
  export ANSIBLE_SSH_TRANSFER_METHOD=piped
  export ANSIBLE_PIPELINING=true
  export ANSIBLE_SSH_USETTY=false
else
  export CLUSTER_STATE_DIR="${CLUSTER_STATE_DIR:-$ROOT/.cluster}"
fi
export ANSIBLE_CONFIG="$ROOT/ansible/ansible.cfg"
export ANSIBLE_LOCAL_TEMP="$CLUSTER_STATE_DIR/ansible-tmp"
export PATH="$CLUSTER_STATE_DIR/tools/bin:$CLUSTER_STATE_DIR/venv/bin:$PATH"
if [[ ${1:-} == setup ]]; then bash "$ROOT/scripts/setup-host.sh" "$ROOT" "$CLUSTER_STATE_DIR"; fi
[[ -x "$CLUSTER_STATE_DIR/venv/bin/python" ]] || { echo '[cluster] Run ./cluster setup (Windows: .\cluster.ps1 setup) first.' >&2; exit 1; }
exec "$CLUSTER_STATE_DIR/venv/bin/python" "$ROOT/scripts/cluster_cli.py" "$@"
